# Puerto HTTP de la API
PORT=3000
NODE_ENV=development

# Conexión a MySQL (sin credenciales reales)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema_biblioteca

# Sustituye el valor por una clave aleatoria larga y privada
JWT_SECRET=reemplaza-por-una-clave-aleatoria-segura
JWT_EXPIRES_IN=1h
JWT_COOKIE_NAME=token
